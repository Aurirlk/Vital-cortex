      "targets": [
        { "expr": "jvm_memory_used_bytes{job=\"personal-health-api\",area=\"heap\"}", "legendFormat": "堆使用", "refId": "A" },
        { "expr": "jvm_memory_max_bytes{job=\"personal-health-api\",area=\"heap\"}", "legendFormat": "堆上限", "refId": "B" }
      ],
      "title": "JVM 堆内存",
      "type": "timeseries"
