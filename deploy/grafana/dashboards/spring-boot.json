      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"personal-health-api\",status=~\"5..\"}[1m]))", "legendFormat": "5xx", "refId": "A" }
      ],
      "title": "HTTP 5xx 速率",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
