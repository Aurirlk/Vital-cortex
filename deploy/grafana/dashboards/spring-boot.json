      "id": 5,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "process_cpu_usage{job=\"personal-health-api\"} * 100", "legendFormat": "进程 CPU", "refId": "A" },
        { "expr": "system_cpu_usage{job=\"personal-health-api\"} * 100", "legendFormat": "系统 CPU", "refId": "B" }
      ],
      "title": "CPU 使用率",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
