# ============================================================
# 智康云 — docker compose 环境变量模板
#
# 用法：
#   cp .env.example .env
#   然后把下面每一个「请改成…」都换成真实值
#
# 为什么必须有这个文件（2026-10-10 补充）：
#   docker-compose.yml 里有 4 个变量用了 `${VAR:?提示}` 语法，
#   缺失时 compose 会在<b>解析阶段</b>直接报错退出 —— 哪怕你只想
#   `docker compose up -d redis` 也一样。此前仓库里既没有 .env
#   也没有 .env.example，使用者只能靠报错信息反推变量名。
#
# ⚠️ .env 已被 .gitignore 忽略，务必不要把真实密钥提交进仓库。
# ============================================================

# ------------------------------------------------------------
# 【必填】缺失则 compose 直接拒绝启动
# ------------------------------------------------------------

# MySQL root 密码（compose 用它初始化 db 服务，同时注入后端 DB_PASS）
DB_ROOT_PASSWORD=请改成强密码

# JWT 签名密钥：至少 32 字节。生成方式：
#   openssl rand -hex 32
# 后端启动时会校验强度，弱密钥/黑名单密钥会拒绝启动。
JWT_SECRET=请改成至少32字节的随机串

# CRM 机器对机器接口密钥（/crm/** 用 API Key 认证，同 JWT 一样 fail-closed）
# 生成方式：openssl rand -hex 32
CRM_API_KEY=请改成至少24字符的随机串

# Grafana 管理员密码
GRAFANA_ADMIN_PASSWORD=请改成强密码

# ------------------------------------------------------------
# 【可选】不填则用中列出的默认值
# ------------------------------------------------------------

# 数据库名 / 端口
DB_NAME=personal_health
DB_PORT=3306

# 对外端口
BACKEND_PORT=21090
FRONTEND_PORT=80

# 监控栈端口
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
REDIS_PORT=6379

# Grafana 登录名与外部访问地址
GRAFANA_ADMIN_USER=admin
GRAFANA_ROOT_URL=http://localhost:3000

# 对外可访问的基础地址：用于拼接上传文件的返回 URL。
# 不配置的话返回的是 localhost，浏览器打不开。
PUBLIC_BASE_URL=http://localhost:21090

# Spring profile（默认 prod，一般不用改）
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------
# AI / RAG
#   ⚠️ 注意变量名：代码读的是属性 ai.chat.api-key，
#      对应环境变量 AI_CHAT_API_KEY（不是 AI_API_KEY）。
#      （为兼容旧文档，compose 里 AI_API_KEY 也可用，会被 AI_CHAT_API_KEY 覆盖。）
# ------------------------------------------------------------
AI_CHAT_API_KEY=
AI_PROVIDER=deepseek

# 嵌入服务端点：DeepSeek 没有 embeddings 接口，必须显式配置
# 例：https://api.siliconflow.cn/v1/embeddings
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ------------------------------------------------------------
# Neo4j 知识图谱（可选，不配则图谱功能自动停用）
# ------------------------------------------------------------
NEO4J_PASSWORD=
