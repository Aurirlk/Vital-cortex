<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.kmbeast.mapper.KbDataSourceMapper">

    <resultMap id="BaseResultMap" type="cn.kmbeast.pojo.entity.KbDataSource">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="type" property="type"/>
        <result column="jdbc_url" property="jdbcUrl"/>
        <result column="username" property="username"/>
        <result column="password_cipher" property="passwordCipher"/>
        <result column="enabled" property="enabled"/>
        <result column="remark" property="remark"/>
        <result column="last_check_time" property="lastCheckTime"/>
        <result column="last_check_ok" property="lastCheckOk"/>
        <result column="last_check_msg" property="lastCheckMsg"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="BaseColumns">
        id, code, name, type, jdbc_url, username, password_cipher, enabled, remark,
        last_check_time, last_check_ok, last_check_msg, create_time, update_time
    </sql>

    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO kb_data_source (code, name, type, jdbc_url, username, password_cipher,
                                    enabled, remark, create_time, update_time)
        VALUES (#{code}, #{name}, COALESCE(#{type}, 'local'), #{jdbcUrl}, #{username}, #{passwordCipher},
                COALESCE(#{enabled}, 1), #{remark}, NOW(), NOW())
    </insert>

    <!-- 仅更新非空字段：管理员改备注时不该把密码清空 -->
    <update id="update">
        UPDATE kb_data_source
        <set>
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="type != null and type != ''">type = #{type},</if>
            <!-- jdbcUrl / username 允许被显式清空（local 类型不需要它们），
                 用 containsKey 判断「传了没有」而不是「空不空」 -->
            <if test="jdbcUrl != null">jdbc_url = #{jdbcUrl},</if>
            <if test="username != null">username = #{username},</if>
            <if test="passwordCipher != null and passwordCipher != ''">password_cipher = #{passwordCipher},</if>
            <if test="enabled != null">enabled = #{enabled},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = NOW(),
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM kb_data_source WHERE id = #{id}
    </delete>

    <select id="query" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM kb_data_source
        <where>
            <if test="code != null and code != ''">
                AND code LIKE CONCAT('%', #{code}, '%')
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="type != null and type != ''">
                AND type = #{type}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY id ASC
        <if test="current != null and size != null">
            LIMIT #{current},#{size}
        </if>
    </select>

    <select id="queryCount" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM kb_data_source
        <where>
            <if test="code != null and code != ''">
                AND code LIKE CONCAT('%', #{code}, '%')
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="type != null and type != ''">
                AND type = #{type}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
    </select>

    <select id="getById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM kb_data_source WHERE id = #{id}
    </select>

    <select id="getByCode" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM kb_data_source WHERE code = #{code}
    </select>

    <select id="listEnabled" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM kb_data_source WHERE enabled = 1 ORDER BY id ASC
    </select>

    <update id="updateCheckResult">
        UPDATE kb_data_source
        SET last_check_time = NOW(), last_check_ok = #{ok}, last_check_msg = #{msg}
        WHERE id = #{id}
    </update>

    <!-- 全库无物理外键，引用完整性由代码维护，故这里手写一次引用计数 -->
    <select id="countKnowledgeBaseRefs" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM knowledge_base WHERE data_source_id = #{id}
    </select>

</mapper>
