<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.kmbeast.mapper.AgentToolBindingMapper">

    <insert id="batchSave">
        INSERT INTO agent_tool_binding (agent_id, tool_name, enabled, sort_order, create_time)
        VALUES
        <foreach collection="list" item="b" separator=",">
            (#{b.agentId}, #{b.toolName}, COALESCE(#{b.enabled}, 1), COALESCE(#{b.sortOrder}, 0), NOW())
        </foreach>
    </insert>

    <delete id="deleteByAgentId">
        DELETE FROM agent_tool_binding WHERE agent_id = #{agentId}
    </delete>

    <select id="queryByAgentId" resultMap="BaseResultMap">
        SELECT * FROM agent_tool_binding
        WHERE agent_id = #{agentId}
        ORDER BY sort_order ASC, id ASC
    </select>

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="cn.kmbeast.pojo.entity.AgentToolBinding">
        <id column="id" property="id"/>
        <result column="agent_id" property="agentId"/>
        <result column="tool_name" property="toolName"/>
        <result column="enabled" property="enabled"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

</mapper>
