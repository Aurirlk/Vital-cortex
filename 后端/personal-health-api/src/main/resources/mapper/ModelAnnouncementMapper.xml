<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.kmbeast.mapper.ModelAnnouncementMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="cn.kmbeast.pojo.entity.ModelAnnouncement">
        <id column="id" property="id"/>
        <result column="model_key" property="modelKey"/>
        <result column="model_name" property="modelName"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="bg_color" property="bgColor"/>
        <result column="icon" property="icon"/>
        <result column="is_online" property="isOnline"/>
        <result column="is_active" property="isActive"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 查询所有横幅列表 -->
    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM model_announcement ORDER BY sort_order ASC, id DESC
    </select>

    <!-- 根据ID查询横幅 -->
    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM model_announcement WHERE id = #{id}
    </select>

    <!-- 根据模型标识查询横幅 -->
    <select id="findByModelKey" resultMap="BaseResultMap">
        SELECT * FROM model_announcement WHERE model_key = #{modelKey}
    </select>

    <!-- 查询当前展示的横幅（is_active=1且is_online=1） -->
    <select id="findActiveAnnouncement" resultMap="BaseResultMap">
        SELECT * FROM model_announcement 
        WHERE is_active = 1 AND is_online = 1 
        ORDER BY sort_order ASC 
        LIMIT 1
    </select>

    <!-- 新增横幅 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO model_announcement (model_key, model_name, title, content, bg_color, icon, is_online, is_active, sort_order)
        VALUES (#{modelKey}, #{modelName}, #{title}, #{content}, #{bgColor}, #{icon}, #{isOnline}, #{isActive}, #{sortOrder})
    </insert>

    <!-- 更新横幅 -->
    <update id="update">
        UPDATE model_announcement
        <set>
            <if test="modelKey != null">model_key = #{modelKey},</if>
            <if test="modelName != null">model_name = #{modelName},</if>
            <if test="title != null">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="bgColor != null">bg_color = #{bgColor},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="isOnline != null">is_online = #{isOnline},</if>
            <if test="isActive != null">is_active = #{isActive},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除横幅 -->
    <delete id="deleteById">
        DELETE FROM model_announcement WHERE id = #{id}
    </delete>

    <!-- 批量删除横幅 -->
    <delete id="batchDelete">
        DELETE FROM model_announcement WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 设置当前展示横幅（先取消所有，再设置指定的） -->
    <update id="setActive">
        UPDATE model_announcement SET is_active = 0 WHERE is_active = 1;
        UPDATE model_announcement SET is_active = 1 WHERE id = #{id};
    </update>

</mapper>
