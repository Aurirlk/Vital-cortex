<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.kmbeast.mapper.UserMapper">
    <insert id="insert" parameterType="cn.kmbeast.pojo.entity.User">
        INSERT INTO user (user_account,
                          user_name,
                          user_pwd,
                          user_avatar,
                          user_email,
                          phone,
                          phone_verified,
                          user_role,
                          is_login,
                          is_word,
                          create_time)
        VALUES (#{userAccount},
                #{userName},
                #{userPwd},
                #{userAvatar},
                #{userEmail},
                #{phone},
                <choose>
                    <when test="phoneVerified != null">#{phoneVerified}</when>
                    <otherwise>0</otherwise>
                </choose>,
                #{userRole},
                #{isLogin},
                #{isWord},
                #{createTime})
    </insert>
    <update id="update" parameterType="cn.kmbeast.pojo.entity.User">
        UPDATE user
        <set>
            <if test="userAccount != null">
                user_account = #{userAccount},
            </if>
            <if test="userName != null">
                user_name = #{userName},
            </if>
            <if test="userPwd != null">
                user_pwd = #{userPwd},
            </if>
            <if test="userAvatar != null">
                user_avatar = #{userAvatar},
            </if>
            <if test="userEmail != null">
                user_email = #{userEmail},
            </if>
            <if test="phone != null">
                phone = #{phone},
            </if>
            <if test="phoneVerified != null">
                phone_verified = #{phoneVerified},
            </if>
            <if test="isLogin != null">
                is_login = #{isLogin},
            </if>
            <if test="isWord != null">
                is_word = #{isWord},
            </if>
            <if test="isVip != null">
                is_vip = #{isVip},
            </if>
            <if test="vipExpireTime != null">
                vip_expire_time = #{vipExpireTime},
            </if>
            <if test="userRole != null">
                user_role = #{userRole},
            </if>
        </set>
        WHERE id = #{id}

    </update>

    <delete id="batchDelete" parameterType="list">
        DELETE FROM user WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="getByActive" resultMap="BaseResultMap">
        SELECT u.*
        FROM user u
        <where>
            1 = 1
            <if test="id != null">
                AND u.id = #{id}
            </if>
            <if test="userName != null and userName != ''">
                AND u.user_name = #{userName}
            </if>
            <if test="userAccount != null and userAccount != ''">
                AND u.user_account = #{userAccount}
            </if>
            <if test="phone != null and phone != ''">
                AND u.phone = #{phone}
            </if>
        </where>
        LIMIT 1
    </select>

    <!--分页查询用户信息-->
    <select id="query" resultMap="BaseResultMap">

        SELECT u.*
        FROM user u
        <where>
            <if test="userAccount != null and userAccount != ''">
                AND u.user_account LIKE concat('%',#{userAccount},'%')
            </if>
            <if test="userName != null and userName != ''">
                AND u.user_name LIKE concat('%',#{userName},'%')
            </if>
            <if test="userEmail != null and userEmail != ''">
                AND u.user_email LIKE concat('%',#{userEmail},'%')
            </if>
            <if test="phone != null and phone != ''">
                AND u.phone LIKE concat('%',#{phone},'%')
            </if>
            <if test="role != null">
                AND u.role = #{role}
            </if>
            <if test="isLogin != null">
                AND u.is_login = #{isLogin}
            </if>
            <if test="isWord != null">
                AND u.is_word = #{isWord}
            </if>
            <if test="startTime != null and endTime != null">
                AND u.create_time BETWEEN #{startTime} AND #{endTime}
            </if>
        </where>
        ORDER BY u.id DESC
        <if test="current != null and size != null">
            LIMIT #{current},#{size}
        </if>
    </select>

    <!--满足分页条件的数据总项-->
    <select id="queryCount" resultType="integer">

        SELECT COUNT(*)
        FROM user u
        <where>
            <if test="userAccount != null and userAccount != ''">
                AND u.user_account LIKE concat('%',#{userAccount},'%')
            </if>
            <if test="userName != null and userName != ''">
                AND u.user_name LIKE concat('%',#{userName},'%')
            </if>
            <if test="userEmail != null and userEmail != ''">
                AND u.user_email LIKE concat('%',#{userEmail},'%')
            </if>
            <if test="phone != null and phone != ''">
                AND u.phone LIKE concat('%',#{phone},'%')
            </if>
            <if test="role != null">
                AND u.role = #{role}
            </if>
            <if test="isLogin != null">
                AND u.is_login = #{isLogin}
            </if>
            <if test="isWord != null">
                AND u.is_word = #{isWord}
            </if>
            <if test="startTime != null and endTime != null">
                AND u.create_time BETWEEN #{startTime} AND #{endTime}
            </if>
        </where>

    </select>

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="cn.kmbeast.pojo.entity.User">
        <id column="id" property="id"/>
        <result column="user_account" property="userAccount"/>
        <result column="user_name" property="userName"/>
        <result column="user_pwd" property="userPwd"/>
        <result column="user_avatar" property="userAvatar"/>
        <result column="user_email" property="userEmail"/>
        <result column="phone" property="phone"/>
        <result column="phone_verified" property="phoneVerified"/>
        <result column="user_role" property="userRole"/>
        <result column="is_login" property="isLogin"/>
        <result column="is_word" property="isWord"/>
        <result column="is_vip" property="isVip"/>
        <result column="vip_expire_time" property="vipExpireTime"/>
        <result column="create_time" property="createTime"/>
        <!-- 用户设置（2026-10-10 新增，见 08_user_settings_columns.sql） -->
        <result column="language" property="language"/>
        <result column="timezone" property="timezone"/>
        <result column="notify_system" property="notifySystem"/>
        <result column="notify_health_remind" property="notifyHealthRemind"/>
        <result column="notify_ai_chat" property="notifyAiChat"/>
        <result column="notify_appointment" property="notifyAppointment"/>
        <result column="notify_order" property="notifyOrder"/>
        <result column="privacy_health_data_share" property="privacyHealthDataShare"/>
        <result column="privacy_profile_visibility" property="privacyProfileVisibility"/>
        <result column="ai_default_agent" property="aiDefaultAgent"/>
        <result column="ai_chat_style" property="aiChatStyle"/>
        <result column="ai_enable_web_search" property="aiEnableWebSearch"/>
        <result column="ai_enable_knowledge_base" property="aiEnableKnowledgeBase"/>
        <result column="ai_context_rounds" property="aiContextRounds"/>
    </resultMap>

    <!-- 根据用户ID获取用户信息 -->
    <select id="getUserById" resultMap="BaseResultMap">
        SELECT u.* FROM user u WHERE u.id = #{userId}
    </select>

    <!--
      保存用户设置（2026-10-10 新增）

      只为设置项开放「只写非空字段」的局部更新，与上面的通用 update 分开：
      通用 update 服务于「编辑资料」，两者共用一条语句的话，任何一次资料保存
      都要把全部设置列带上，反而容易误清空。这里前端每次只提交一组设置
      （例如只提交 notification），因此必须允许只更新部分列。
    -->
    <update id="updateSettings" parameterType="cn.kmbeast.pojo.entity.User">
        UPDATE user
        <set>
            <if test="language != null">language = #{language},</if>
            <if test="timezone != null">timezone = #{timezone},</if>
            <if test="notifySystem != null">notify_system = #{notifySystem},</if>
            <if test="notifyHealthRemind != null">notify_health_remind = #{notifyHealthRemind},</if>
            <if test="notifyAiChat != null">notify_ai_chat = #{notifyAiChat},</if>
            <if test="notifyAppointment != null">notify_appointment = #{notifyAppointment},</if>
            <if test="notifyOrder != null">notify_order = #{notifyOrder},</if>
            <if test="privacyHealthDataShare != null">privacy_health_data_share = #{privacyHealthDataShare},</if>
            <if test="privacyProfileVisibility != null">privacy_profile_visibility = #{privacyProfileVisibility},</if>
            <if test="aiDefaultAgent != null">ai_default_agent = #{aiDefaultAgent},</if>
            <if test="aiChatStyle != null">ai_chat_style = #{aiChatStyle},</if>
            <if test="aiEnableWebSearch != null">ai_enable_web_search = #{aiEnableWebSearch},</if>
            <if test="aiEnableKnowledgeBase != null">ai_enable_knowledge_base = #{aiEnableKnowledgeBase},</if>
            <if test="aiContextRounds != null">ai_context_rounds = #{aiContextRounds},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据手机号查找用户
         2026-10-03 修正：原实现是 WHERE user_account = #{userAccount}，
         拿手机号去匹配逻辑账号（admin/lily），永远不会命中
         —— 这正是短信登录 100% 失败的根源。现改为匹配真正的 phone 字段。 -->
    <select id="findByPhone" resultMap="BaseResultMap">
        SELECT u.* FROM user u WHERE u.phone = #{phone} LIMIT 1
    </select>

    <!-- 统一登录标识查找：账号或手机号任一命中即可。
         用途：登录页「账号登录」与「短信登录」共用一套后端逻辑。 -->
    <select id="findByIdentifier" resultMap="BaseResultMap">
        SELECT u.* FROM user u
        WHERE (u.user_account = #{identifier} OR u.phone = #{identifier})
        LIMIT 1
    </select>

    <!-- 患者选择器远程搜索：姓名 / 账号 / 手机号（含后4位）模糊匹配
         供 <PatientSelect> 组件与医生端「我的患者」使用；仅返回普通用户（role=2）。 -->
    <select id="searchForSelect" resultMap="BaseResultMap">
        SELECT u.id, u.user_account, u.user_name, u.user_avatar, u.user_email,
               u.phone, u.phone_verified, u.user_role, u.is_login, u.is_word,
               u.is_vip, u.vip_expire_time, u.create_time
        FROM user u
        WHERE u.user_role = 2
        <if test="keyword != null and keyword != ''">
            AND (u.user_name LIKE CONCAT('%', #{keyword}, '%')
                 OR u.user_account LIKE CONCAT('%', #{keyword}, '%')
                 OR u.phone LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        ORDER BY
            CASE WHEN u.user_name LIKE CONCAT(#{keyword}, '%') THEN 0
                 WHEN u.phone LIKE CONCAT(#{keyword}, '%') THEN 1
                 ELSE 2 END,
            u.id ASC
        LIMIT #{limit}
    </select>

    <!-- 手机号占用校验（注册/绑定用，excludeId 用于排除自身） -->
    <select id="countByPhone" resultType="int">
        SELECT COUNT(*) FROM user
        WHERE phone = #{phone}
        <if test="excludeId != null">AND id != #{excludeId}</if>
    </select>

    <!-- 用户通知开关（2026-10-10 新增，见 08_user_settings_columns.sql）
         只取发通知前要判断的五列：高频路径，不把整行（含 user_pwd）读出来。
         列名到属性名的映射走 map-underscore-to-camel-case，故这里显式起别名。 -->
    <select id="getNotifyPreference" resultType="cn.kmbeast.pojo.vo.NotifyPreferenceVO">
        SELECT notify_system        AS systemNotify,
               notify_health_remind AS healthRemindNotify,
               notify_ai_chat       AS aiChatNotify,
               notify_appointment   AS appointmentNotify,
               notify_order         AS orderNotify
        FROM `user`
        WHERE id = #{userId}
    </select>

</mapper>
